PROFILE_ID=example-ingress
PROFILE_NAME="Example ingress"
ROLE=panel-ingress
ENABLED=true
ET_NETWORK_NAME=ix-example
ET_NETWORK_SECRET=change-me
ET_SUBNET=EASYTIER_SUBNET
ET_HOSTNAME=ix-ingress-example
ET_IPV4=EASYTIER_INGRESS_IPV4_CIDR
CNIX_ENTRY_PROTOS="tcp udp"
CNIX_ENTRY_PROTO=both
CNIX_ENTRY_HOST=cnix-entry.example
CNIX_ENTRY_PORT=30000
ET_PEERS="tcp://cnix-entry.example:30000 udp://cnix-entry.example:30000"
ET_NO_LISTENER=true
LOCAL_PORT=20000
LANDING_ET_IP=EASYTIER_LANDING_IPV4
REMOTE_PORT=20000
FORWARD_PROTO=both
FORWARD_ENABLED=true
LANDING_PUBLIC_HOST=landing.example
REMARK=
