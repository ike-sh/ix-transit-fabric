PROFILE_ID=example-backup
PROFILE_NAME="Example backup ingress"
ROLE=panel-ingress
ENABLED=true
LINE_GROUP=example-group
LINE_ROLE=backup
LINE_PRIORITY=20
HEALTH_CHECK_ENABLED=true
HEALTH_STATUS=unknown
ET_NETWORK_NAME=ix-example-backup
ET_NETWORK_SECRET=change-me
ET_SUBNET=EASYTIER_BACKUP_SUBNET
ET_HOSTNAME=ix-ingress-example-backup
ET_IPV4=EASYTIER_BACKUP_IPV4_CIDR
CNIX_ENTRY_PROTO=both
CNIX_ENTRY_HOST=cnix-entry.example
CNIX_ENTRY_PORT=30000
ET_PEERS="tcp://cnix-entry.example:30000 udp://cnix-entry.example:30000"
ET_NO_LISTENER=true
FORWARD_ENABLED=false
LOCAL_PORT=20000
LANDING_ET_IP=EASYTIER_BACKUP_LANDING_IPV4
REMOTE_PORT=20000
FORWARD_PROTO=both
CODE_LISTENER_PORT=50000
LANDING_PUBLIC_HOST=landing.example
