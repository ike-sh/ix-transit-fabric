# NAT-IX ingress example for ix-transit-fabric.
# Placeholder values only. Do not paste real access codes or tokens here.

PROFILE_ID=nat-ingress-example
PROFILE_NAME=nat-ingress-example
ROLE=nat-ingress
NAT_DIRECTION=nat-listener
ENABLED=true
FORWARD_ENABLED=true

ET_NETWORK_NAME=ix-change-me
ET_NETWORK_SECRET=change-me
ET_HOSTNAME=ingress.example
ET_IPV4=10.88.0.1/24
ET_SUBNET=10.88.0.0/24
ET_PRIVATE_MODE=true
ET_EXPLICIT_ONLY=true
IXTF_EXPLICIT_ONLY=true

INGRESS_HOSTNAME=ingress.example
INGRESS_ET_IP=10.88.0.1
INGRESS_ET_CIDR=10.88.0.1/24

NAT_ET_IP=10.88.0.2
NAT_ET_CIDR=10.88.0.2/24
NAT_PUBLIC_HOST=nat-ix.example
NAT_LISTENER_PROTO=both
NAT_LISTENER_PROTOS="tcp udp"
NAT_LISTENER_PORT=20000
ET_PEERS="tcp://nat-ix.example:20000 udp://nat-ix.example:20000"
ET_NO_LISTENER=true

INGRESS_PUBLIC_HOST=ingress.example
LOCAL_PORT=30000
TRANSIT_PORT=31000
LANDING_HOST=landing.example
LANDING_PORT=50000
FORWARD_PROTO=both
