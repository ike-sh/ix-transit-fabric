# NAT IX 中转线路示例。
# 仅使用占位值；不要粘贴真实密钥、真实接入码或真实 token。

PROFILE_ID=nat-ix-listener-example
PROFILE_NAME=nat-ix-listener-example
ROLE=nat-transit
NAT_DIRECTION=nat-listener
ENABLED=true
FORWARD_ENABLED=true

ET_NETWORK_NAME=ix-change-me
ET_NETWORK_SECRET=change-me
ET_HOSTNAME=nat-ix.example
ET_IPV4=10.88.0.2/24
ET_SUBNET=10.88.0.0/24
ET_PRIVATE_MODE=true
ET_EXPLICIT_ONLY=true
IXTF_EXPLICIT_ONLY=true

INGRESS_ET_IP=10.88.0.1
INGRESS_ET_CIDR=10.88.0.1/24

NAT_ET_IP=10.88.0.2
NAT_ET_CIDR=10.88.0.2/24
NAT_PUBLIC_HOST=nat-ix.example
NAT_LISTENER_PROTO=both
NAT_LISTENER_PROTOS="tcp udp"
NAT_LISTENER_PORT=20000
ET_LISTENER_PROTO=both
ET_LISTENER_PORT=20000
ET_LISTENERS="tcp://0.0.0.0:20000 udp://0.0.0.0:20000"
ET_NO_LISTENER=false

# 1.1.0 单规则字段会兼容为 rules/nat-ix-listener-example/rule-main.env。
TRANSIT_PORT=40000
LANDING_HOST=landing-a.example
LANDING_PORT=50000
FORWARD_PROTO=both

# 可选：EasyTier TUN MTU（576-9000）；写入接入码并在公网入口导入时同步
# ET_MTU=1280

# 多规则示例请见 examples/multi-rules.md。
